---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleReader from "../../components/ArticleReader.astro";
import { getArticleBody, listArticles } from "../../utils/body";
import { getArticleMeta, articleRedirects } from "../../utils/articles";

export async function getStaticPaths() {
  return listArticles()
    .filter((slug) => !(slug in articleRedirects))
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const meta = getArticleMeta(slug);
const bodyHtml = getArticleBody(slug);
---

<BaseLayout title={meta.title} description={meta.description} showToc={true}>
  {
    bodyHtml ? (
      <ArticleReader
        title={meta.title}
        description={meta.description}
        bodyHtml={bodyHtml}
      />
    ) : (
      <div class="max-w-3xl mx-auto px-4 sm:px-6 py-20 text-center">
        <h1 class="text-2xl font-bold text-white">Article not found</h1>
        <p class="mt-2 text-zinc-400">No body written for “{slug}” yet.</p>
        <a
          href="/future-of-ai/"
          class="mt-6 inline-block text-sm text-blue-400 hover:underline"
        >
          ← Essay
        </a>
      </div>
    )
  }
</BaseLayout>
