---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntityDetail from '../../../components/EntityDetail.astro';
import { loadEntities } from '../../../utils/entity-loader';
import { getRelationsFromEntity, getRelationsToEntity } from '../../../utils/relation-loader';
import { getEntityBody } from '../../../utils/body';

export async function getStaticPaths() {
  const entities = loadEntities();
  return entities.map((entity) => ({
    params: { id: entity.id },
    props: { entity },
  }));
}

const { entity } = Astro.props;
const outgoing = getRelationsFromEntity(entity.id);
const incoming = getRelationsToEntity(entity.id);
const bodyHtml = getEntityBody(entity.id);
const labels: Record<string, string> = {};
for (const e of loadEntities()) labels[e.id] = e.label;
---

<BaseLayout title={entity.label} description={entity.short}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10" transition:animate="fade">
    <nav class="text-xs text-zinc-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-zinc-300 transition-colors">← Essay</a>
      <span>/</span>
      <span class="text-zinc-300">{entity.label}</span>
    </nav>
    <EntityDetail
      entity={entity}
      outgoing={outgoing}
      incoming={incoming}
      entityLabels={labels}
      bodyHtml={bodyHtml}
      variant="full"
    />
  </div>
</BaseLayout>
