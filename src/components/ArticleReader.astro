---
import Prose from './Prose.astro';

interface Props {
  title: string;
  description: string;
  bodyHtml: string;
}

const { title, description, bodyHtml } = Astro.props;
---

<div class="article-content" transition:animate="fade">
  <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">{title}</h1>
  <p class="mt-3 text-zinc-400">{description}</p>
  <p class="mt-3 text-xs text-zinc-500">Hakan Tugrul Otal, 12 September 2026</p>
  <hr class="my-8 border-surface-2" />
  <Prose><Fragment set:html={bodyHtml} /></Prose>
</div>

<style>
  .article-content {
    max-width: 72ch;
    padding: 2.5rem 2rem 4rem;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .article-content {
      padding: 1.5rem 1rem 3rem;
    }
  }
</style>
