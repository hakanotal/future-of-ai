---
interface Props {
  strand: string;
  size?: 'sm' | 'md' | 'lg';
  showLabel?: boolean;
}

const { strand, size = 'md', showLabel = false } = Astro.props;

const strandConfig: Record<string, { color: string; label: string }> = {
  T: { color: 'bg-strand-t', label: 'Transhumanism' },
  E: { color: 'bg-strand-e', label: 'Extropianism' },
  S: { color: 'bg-strand-s', label: 'Singularitarianism' },
  C: { color: 'bg-strand-c', label: 'Cosmism' },
  R: { color: 'bg-strand-r', label: 'Rationalism' },
  EA: { color: 'bg-strand-ea', label: 'Effective Altruism' },
  L: { color: 'bg-strand-l', label: 'Longtermism' },
};

const config = strandConfig[strand] || { color: 'bg-zinc-500', label: strand };

const sizeClasses = {
  sm: 'w-1.5 h-1.5',
  md: 'w-2 h-2',
  lg: 'w-3 h-3',
};
---

<span class="inline-flex items-center gap-1.5">
  <span
    class:list={[sizeClasses[size], 'rounded-full', config.color]}
    title={config.label}
  />
  {showLabel && (
    <span class="text-zinc-400 text-sm">{config.label}</span>
  )}
</span>
